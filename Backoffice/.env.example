# ─── Environnement ────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development

# ─── Firebase — SDK CLIENT (navigateur, listeners temps réel) ─────
# Publique par nature : ce sont les Security Rules qui protègent les données.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=carlinq-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=carlinq-dev
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://carlinq-dev-default-rtdb.europe-west1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=carlinq-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FUNCTIONS_REGION=europe-west1

# ─── Firebase — ADMIN SDK (serveur uniquement) ────────────────────
# SECRET. Compte de service JSON encodé en base64.
# Jamais exposé au navigateur, jamais commité, jamais préfixé NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT=

# ─── Cartographie ─────────────────────────────────────────────────
# Clé Google Maps JavaScript API — À RESTREINDRE PAR DOMAINE HTTP
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Développement ────────────────────────────────────────────────
# true → branche l'Admin SDK et le SDK client sur les émulateurs Firebase
FIREBASE_USE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000

# ─── Monitoring ───────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
