# Copier en .env pour surcharger les valeurs par defaut (docker compose le lit s'il existe).
APP_NAME=Carlinq API
APP_ENV=development
SECRET_KEY=change-me-very-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Hors Docker (uvicorn local) : base exposee par docker compose sur le port 55432.
DATABASE_URL=postgresql+psycopg2://carlinq:carlinq@localhost:55432/carlinq
TIMEZONE=Africa/Douala
# Cache Redis (vide = desactive). Hors Docker : port 56379.
REDIS_URL=redis://localhost:56379/0
CACHE_TTL_SECONDS=300
CORS_ORIGINS=*
# Les regles metier (commission 8 %, supplements, paliers d'objectifs, regles de
# partage d'objectif) sont en base : GET/PUT /api/v1/admin/settings/{pricing,goals}.
