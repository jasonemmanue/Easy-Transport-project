APP_NAME=EasyTransport API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-very-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/easytransport
REDIS_URL=redis://localhost:6379/0

GOOGLE_MAPS_API_KEY=
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

COMMISSION_RATE=0.08
MIN_WALLET_XAF=500
CANCELLATION_FREE_WINDOW_SECONDS=15
TRAFFIC_TOLERANCE_MINUTES=2
COPILOTE_MONTHLY_QUOTA_XAF=5000
